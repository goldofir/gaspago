# Caddy provisiona certificado HTTPS automaticamente via Let's Encrypt.
#
# Antes de usar este arquivo:
#   1. Aponte o DNS (registro A) de gaspago.app e api.gaspago.app pro IP publico deste servidor.
#   2. Certifique-se de que as portas 80 e 443 estao liberadas no firewall —
#      o Caddy precisa da porta 80 para validar o certificado via HTTP-01.

gaspago.app {
  reverse_proxy web:3001
}

api.gaspago.app {
  reverse_proxy api:3000
}
