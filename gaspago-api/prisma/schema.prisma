generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum AffiliateStatus {
  ACTIVE    // consumed this month — commissions flow
  BLOCKED   // 1 month without purchase — commissions frozen
  EXPIRED   // 2 months — frozen commissions forfeited to company
}

enum ActorType {
  CONSUMER
  DISTRIBUTOR
  ESTABLISHMENT
  CREDENCIADOR
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  FGOL_BALANCE
  MIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionStatus {
  PENDING   // awaiting delivery confirmation
  RELEASED  // consumer active — available to withdraw
  BLOCKED   // affiliate inactive this month — frozen
  EXPIRED   // 2 months inactive — moved to company revenue
  SETTLED   // included in a buyback batch or BRL transfer
}

enum Currency {
  BRL
  FGOL
}

enum PlanType {
  FREE
  PREMIUM
}

enum PosPaymentStatus {
  AWAITING_SCAN
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  phone         String        @unique
  name          String?
  email         String?       @unique
  cpf           String?       @unique
  googleId      String?       @unique
  avatarUrl     String?
  kycVerified   Boolean       @default(false)
  plan          PlanType      @default(FREE)
  planExpiresAt DateTime?
  referralCode  String        @unique @default(cuid())
  referredById  String?

  // Affiliate state machine
  affiliateStatus       AffiliateStatus @default(ACTIVE)
  monthsWithoutPurchase Int             @default(0)
  lastPurchaseAt        DateTime?

  // Matrix
  matrixPosition MatrixPosition?

  // FGOL internal ledger (off-chain — settled in batch)
  fgolBalance Decimal @default(0) @db.Decimal(20, 8)
  fgolFrozen  Decimal @default(0) @db.Decimal(20, 8) // BLOCKED commissions

  // On-chain address (Web3Auth embedded wallet)
  walletAddress String?

  // Asaas — only for actors that receive BRL (credenciador, establishment owner)
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  actorType ActorType @default(CONSUMER)

  // Portal login (DISTRIBUTOR / CREDENCIADOR / ESTABLISHMENT staff) — bcrypt hash, never plaintext
  passwordHash    String?
  distributorId   String? // links a DISTRIBUTOR-role User to their Distributor
  establishmentId String? // links an ESTABLISHMENT-role User to their Establishment

  // Push notifications
  pushToken String?

  // WhatsApp — conexbot contact reference
  waId String? @unique // E.164 phone, matches conexbot contact

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               Order[]
  commissionsReceived  CommissionLedger[] @relation("Recipient")
  posPaymentsInitiated PosPayment[]
}

// ─── MATRIX 5×5 (hidden from users — visible only in SuperAdmin) ──────────────

model MatrixPosition {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  parentId String?
  parent   MatrixPosition?  @relation("Tree", fields: [parentId], references: [id])
  children MatrixPosition[] @relation("Tree")

  level    Int    // 1–5
  position Int    // 1–5 within parent
  path     String // "1.2.3" — for tree traversal queries
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

// ─── DISTRIBUTORS ─────────────────────────────────────────────────────────────

model Distributor {
  id   String @id @default(cuid())
  name String
  cnpj String @unique

  // Contact
  phone String @unique
  email String?

  // Location + service zone
  address         String
  city            String
  state           String
  postalCode      String
  lat             Float?
  lng             Float?
  serviceRadiusKm Float @default(5)

  // Onboarded by
  credenciadorId String // User.id

  // Quality
  rating      Float @default(0)
  ratingCount Int   @default(0)
  isActive    Boolean @default(true)

  // Cashback offer (variable — set by distributor)
  cashbackPercent Float // e.g. 0.20 = 20% of sale available for distribution

  // Asaas sub-account (receives BRL via internal transfer)
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  // WhatsApp / CONEXAO bot config
  conexaoApiKey     String? // key provided by conexbot
  conexaoWebhookUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
}

// ─── ESTABLISHMENTS (marketplace — restaurants, pharmacies, markets, etc.) ────

model Establishment {
  id          String  @id @default(cuid())
  name        String
  category    String  // "restaurante" | "farmacia" | "mercado" | "servico"
  description String?
  cnpj        String  @unique
  phone       String?

  address    String
  city       String
  state      String
  postalCode String
  lat        Float?
  lng        Float?

  credenciadorId  String
  rating          Float   @default(0)
  ratingCount     Int     @default(0)
  isActive        Boolean @default(true)

  // Cashback offer (variable — establishment sets to attract traffic)
  cashbackPercent Float
  minimumPurchase Decimal? @db.Decimal(10, 2)

  // Asaas sub-account
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posPayments PosPayment[]
}

// ─── PRODUCTS (gas + other distributor products) ──────────────────────────────

model Product {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])

  name        String  // "Botijão 13kg" | "Botijão 45kg" | "Gás Industrial"
  description String?
  price       Decimal @db.Decimal(10, 2)
  unit        String  @default("unidade")
  isAvailable Boolean @default(true)
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

// ─── ORDERS (gas delivery + other distributor products) ───────────────────────

model Order {
  id             String      @id @default(cuid())
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  distributorId  String
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  status OrderStatus @default(PENDING)

  // Delivery
  deliveryAddress    String
  deliveryPostalCode String
  deliveryLat        Float?
  deliveryLng        Float?
  estimatedMinutes   Int?
  deliveredAt        DateTime?

  // Financials
  subtotal        Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  marginOffered   Decimal @db.Decimal(10, 2) // cashbackPercent × total = pool for distribution
  cashbackPercent Float   // snapshot of distributor's offer at order time

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  asaasChargeId String? // Asaas PIX charge reference

  // FGOL used as partial payment
  fgolUsed         Decimal @default(0) @db.Decimal(20, 8)
  fgolUsedBrlValue Decimal @default(0) @db.Decimal(10, 2) // BRL equivalent at swap time

  // WhatsApp channel reference (conexbot conversation)
  waConversationId String?
  channel          String  @default("app") // "app" | "whatsapp"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  commissions CommissionLedger[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
}

// ─── POS — physical establishment payments (QR code at counter) ───────────────

model PosPayment {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])

  totalAmount     Decimal @db.Decimal(10, 2) // full bill
  fgolUsed        Decimal @default(0) @db.Decimal(20, 8)
  fgolBrlValue    Decimal @default(0) @db.Decimal(10, 2) // BRL equiv of FGOL used
  pixAmount       Decimal @db.Decimal(10, 2) // remainder charged via PIX

  marginOffered   Decimal @db.Decimal(10, 2) // cashbackPercent × totalAmount
  cashbackPercent Float   // snapshot at payment time

  // QR code (generated by establishment panel, scanned by consumer app)
  qrToken     String   @unique // signed JWT with {estId, amount, exp}
  qrExpiresAt DateTime

  status        PosPaymentStatus @default(AWAITING_SCAN)
  asaasChargeId String? // PIX charge for pixAmount from consumer
  asaasTransferId String? // internal Asaas transfer to establishment

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  commissions CommissionLedger[]
}

// ─── COMMISSION LEDGER ────────────────────────────────────────────────────────

model CommissionLedger {
  id          String @id @default(cuid())
  recipientId String
  recipient   User   @relation("Recipient", fields: [recipientId], references: [id])

  // Source transaction — one of these is set
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id])
  posPaymentId String?
  posPayment   PosPayment? @relation(fields: [posPaymentId], references: [id])

  amount   Decimal          @db.Decimal(20, 8)
  currency Currency
  status   CommissionStatus @default(PENDING)

  // Role in the distribution
  role String
  // "consumer_cashback" | "network_l1" | "network_l2" | "network_l3"
  // | "network_l4" | "network_l5" | "credenciador" | "establishment_bonus" | "platform"

  matrixLevel Int? // which level of the 5×5 generated this

  // Blocking / expiry (mirrors affiliate state machine)
  blockedAt DateTime?
  expiresAt DateTime? // set on BLOCKED: now + 60 days
  expiredAt DateTime? // set when moved to EXPIRED → company revenue

  // FGOL batch settlement
  buybackBatchId String?

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── FGOL BUYBACK BATCHES (weekly — company buys FGOL from pool) ──────────────

model BuybackBatch {
  id             String @id @default(cuid())
  brlSpent       Decimal @db.Decimal(10, 2)
  fgolAcquired   Decimal @db.Decimal(20, 8)
  pricePerFgol   Decimal @db.Decimal(20, 8) // BRL/FGOL at swap moment
  polygonTxHash  String?

  commissionsSettled Int @default(0)

  executedAt DateTime
  createdAt  DateTime @default(now())
}

// ─── ASAAS SUB-ACCOUNTS registry ─────────────────────────────────────────────

model AsaasSubAccount {
  id        String @id @default(cuid())
  actorType String // "DISTRIBUTOR" | "CREDENCIADOR" | "ESTABLISHMENT"
  actorId   String // references the relevant table

  asaasAccountId String @unique
  pixKey         String?

  createdAt DateTime @default(now())
}

// ─── RATINGS ─────────────────────────────────────────────────────────────────

model Rating {
  id              String  @id @default(cuid())
  customerId      String
  distributorId   String?
  establishmentId String?
  score           Int     // 1–5
  comment         String?
  createdAt       DateTime @default(now())
}

// ─── SUBSCRIPTIONS (Free / Premium) ──────────────────────────────────────────

model Subscription {
  id         String   @id @default(cuid())
  userId     String   @unique
  plan       PlanType
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  asaasSubId String?  // Asaas recurring charge reference
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── SYSTEM CONFIG (credentials managed via SuperAdmin — values encrypted) ────

model SystemConfig {
  key       String   @id  // e.g. "ASAAS_API_KEY"
  value     String       // AES-256-GCM encrypted
  label     String       // human-readable name shown in UI
  group     String       // "asaas" | "conexbot" | "polygon" | "web3auth" | "email" | "storage"
  sensitive Boolean @default(true) // if true, mask in GET responses
  updatedAt DateTime @updatedAt
  updatedBy String?      // User.id of the admin who last changed it
}

// ─── COMPANY REVENUE LEDGER (forfeited commissions + platform cut) ────────────

model CompanyRevenue {
  id     String @id @default(cuid())
  amount Decimal @db.Decimal(20, 8)
  currency Currency

  source String
  // "platform_cut" | "forfeited_commission" | "expired_premium"

  referenceId String? // CommissionLedger.id or Order.id

  createdAt DateTime @default(now())
}
