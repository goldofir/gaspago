generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum AffiliateStatus {
  ACTIVE    // consumed this month — commissions flow
  BLOCKED   // 1 month without purchase — commissions frozen
  EXPIRED   // 2 months — frozen commissions forfeited to company
}

enum ActorType {
  CONSUMER
  DISTRIBUTOR
  ESTABLISHMENT
  CREDENCIADOR
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CARD
  FGOL_BALANCE
  MIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CommissionStatus {
  PENDING   // awaiting delivery confirmation
  RELEASED  // consumer active — available to withdraw
  BLOCKED   // affiliate inactive this month — frozen
  EXPIRED   // 2 months inactive — moved to company revenue
  SETTLED   // included in a buyback batch or BRL transfer
}

enum Currency {
  BRL
  FGOL
}

enum PlanType {
  FREE
  PREMIUM
}

enum PosPaymentStatus {
  AWAITING_SCAN
  AWAITING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
}

enum OnChainDirection {
  TO_USER    // treasury -> user wallet (earned FGOL, batched)
  FROM_USER  // user wallet -> treasury (redemption pull-back, via approve/transferFrom)
}

enum OnChainTransferStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum RedeemLock {
  NONE       // fully usable (PIX + marketplace)
  PIX_LOCKED // 30d+ without consumption — marketplace still usable, PIX withdrawal blocked
  EXPIRED    // 60d+ without consumption — balance forfeited
}

// Self-service partner signup (distributor/establishment via Web3Auth) creates
// the User immediately but the Distributor/Establishment record only once
// SuperAdmin fills in the business terms it can't self-declare (credenciador,
// cashback%, service address) — see PartnerLead.userId. Existing admin-created
// portal accounts default to ACTIVE since they were never gated this way.
enum PortalAccountStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

enum KycLevel {
  LEVEL_0_UNVERIFIED  // Default: no PIX withdrawal allowed
  LEVEL_1_BASIC       // CPF + Phone/Email verified (up to R$ 500/month)
  LEVEL_2_VERIFIED    // Documents (RG/CNH) + Selfie Liveness approved (up to R$ 10.000/month)
  LEVEL_3_ENTERPRISE  // Full B2B / Address + Business docs approved (Unlimited)
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  IN_AUTOMATED_CHECK
  APPROVED
  REJECTED
  SUSPECTED_FRAUD
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id            String        @id @default(cuid())
  phone         String        @unique
  name          String?
  email         String?       @unique
  cpf           String?       @unique
  googleId      String?       @unique
  avatarUrl     String?
  kycVerified   Boolean       @default(false)
  kycLevel      KycLevel      @default(LEVEL_0_UNVERIFIED)
  plan          PlanType      @default(FREE)

  planExpiresAt DateTime?
  referralCode  String        @unique @default(cuid())
  referredById  String?

  // Affiliate state machine
  affiliateStatus       AffiliateStatus @default(ACTIVE)
  monthsWithoutPurchase Int             @default(0)
  lastPurchaseAt        DateTime?

  // Matrix
  matrixPosition MatrixPosition?

  // FGOL internal ledger — authoritative for what's redeemable (PIX / marketplace).
  // Only ever credited by internal platform events (commission, cashback, internal
  // transfer) — never synced from on-chain wallet state.
  fgolBalance Decimal @default(0) @db.Decimal(20, 8)
  fgolFrozen  Decimal @default(0) @db.Decimal(20, 8) // BLOCKED commissions

  // On-chain address (Web3Auth embedded wallet) — unique so it can double as a
  // login lookup key for Web3Auth-authenticated partner accounts (see /auth/web3auth-login).
  walletAddress    String? @unique
  walletApprovedAt DateTime? // set once the user signs the one-time approve() letting
                              // the treasury pull redeemed FGOL back via transferFrom

  // Earned FGOL not yet pushed on-chain — batched to avoid a tx per small commission.
  // Flushed to a real treasury->wallet transfer once it crosses the configured threshold.
  pendingOnChainAmount Decimal @default(0) @db.Decimal(20, 8)

  // Redemption window — tracks activity independent of the affiliate network state
  // machine above. Updated on every Order / marketplace PosPayment as payer.
  lastConsumptionAt DateTime?

  // Asaas — only for actors that receive BRL (credenciador, establishment owner)
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  // Asaas Customer record — for consumers, so a real PIX charge can be created
  // against them at checkout (POS/marketplace/order). Created lazily on first
  // charge and cached here so we never create duplicate Asaas customers.
  asaasCustomerId String? @unique

  actorType ActorType @default(CONSUMER)

  // Portal login (DISTRIBUTOR / CREDENCIADOR / ESTABLISHMENT staff) — bcrypt hash, never plaintext.
  // passwordHash is optional because self-service partner signups authenticate
  // via Web3Auth (walletAddress) instead — see PortalAccountStatus.
  passwordHash    String?
  distributorId   String? // links a DISTRIBUTOR-role User to their Distributor
  establishmentId String? // links an ESTABLISHMENT-role User to their Establishment
  portalStatus    PortalAccountStatus @default(ACTIVE)
  partnerLead     PartnerLead?

  // Push notifications
  pushToken String?

  // WhatsApp — conexbot contact reference
  waId String? @unique // E.164 phone, matches conexbot contact

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               Order[]
  commissionsReceived  CommissionLedger[] @relation("Recipient")
  posPaymentsInitiated PosPayment[]
  onChainTransfers     OnChainTransfer[]
  kycSubmission        KycSubmission?
}

// ─── KYC SUBMISSIONS (Premium Multi-level KYC & Fraud Prevention) ────────────

model KycSubmission {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetLevel     KycLevel  @default(LEVEL_2_VERIFIED)
  status          KycStatus @default(PENDING_REVIEW)

  // Submitted identification details
  documentType    String    // "RG" | "CNH" | "PASSPORT"
  documentNumber  String
  fullName        String
  cpf             String
  birthDate       String?

  // MinIO storage keys (Private Bucket `kyc/`)
  frontImageKey   String
  backImageKey    String?
  selfieImageKey  String

  // Automated scores & AI compliance checks
  ocrConfidence   Float     @default(0.95)
  livenessScore   Float     @default(0.98)
  pepCheckPassed  Boolean   @default(true)
  sanctionsPassed Boolean   @default(true)

  rejectionReason String?
  adminNotes      String?

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  auditLogs       KycAuditLog[]
}

model KycAuditLog {
  id            String        @id @default(cuid())
  submissionId  String
  submission    KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  actorId       String        // Admin User ID or "SYSTEM_AI"
  action        String        // "SUBMITTED" | "AUTO_CHECK_PASSED" | "APPROVED" | "REJECTED" | "FLAGGED_FRAUD"
  notes         String?
  ipAddress     String?

  createdAt     DateTime      @default(now())
}


// ─── MATRIX 5×5 (hidden from users — visible only in SuperAdmin) ──────────────

model MatrixPosition {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  parentId String?
  parent   MatrixPosition?  @relation("Tree", fields: [parentId], references: [id])
  children MatrixPosition[] @relation("Tree")

  level    Int    // 1–5
  position Int    // 1–5 within parent
  path     String // "1.2.3" — for tree traversal queries
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

// ─── DISTRIBUTORS ─────────────────────────────────────────────────────────────

model Distributor {
  id   String @id @default(cuid())
  name String
  cnpj String @unique

  // Contact
  phone String @unique
  email String?

  // Location + service zone
  address         String
  city            String
  state           String
  postalCode      String
  lat             Float?
  lng             Float?
  serviceRadiusKm Float @default(5)

  // Onboarded by
  credenciadorId String // User.id

  // Quality
  rating      Float @default(0)
  ratingCount Int   @default(0)
  isActive    Boolean @default(true)

  // Cashback offer (variable — set by distributor)
  cashbackPercent Float // e.g. 0.20 = 20% of sale available for distribution

  // Asaas sub-account (receives BRL via internal transfer)
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  // WhatsApp / CONEXAO bot config
  conexaoApiKey     String? // key provided by conexbot
  conexaoWebhookUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
}

// ─── ESTABLISHMENTS (marketplace — restaurants, pharmacies, markets, etc.) ────

model Establishment {
  id          String  @id @default(cuid())
  name        String
  category    String  // "restaurante" | "farmacia" | "mercado" | "servico"
  description String?
  cnpj        String  @unique
  phone       String?

  address    String
  city       String
  state      String
  postalCode String
  lat        Float?
  lng        Float?

  credenciadorId  String
  rating          Float   @default(0)
  ratingCount     Int     @default(0)
  isActive        Boolean @default(true)

  // Cashback offer (variable — establishment sets to attract traffic)
  cashbackPercent Float
  minimumPurchase Decimal? @db.Decimal(10, 2)

  // Asaas sub-account
  asaasSubAccountId String? @unique
  asaasPixKey       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posPayments      PosPayment[]
  marketplaceItems MarketplaceItem[]
}

// ─── MARKETPLACE CATALOG (items an establishment sells through the marketplace) ─

model MarketplaceItem {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ─── PRODUCTS (gas + other distributor products) ──────────────────────────────

model Product {
  id            String      @id @default(cuid())
  distributorId String
  distributor   Distributor @relation(fields: [distributorId], references: [id])

  name        String  // "Botijão 13kg" | "Botijão 45kg" | "Gás Industrial"
  description String?
  price       Decimal @db.Decimal(10, 2)
  unit        String  @default("unidade")
  isAvailable Boolean @default(true)
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

// ─── ORDERS (gas delivery + other distributor products) ───────────────────────

model Order {
  id             String      @id @default(cuid())
  customerId     String
  customer       User        @relation(fields: [customerId], references: [id])
  distributorId  String
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  status OrderStatus @default(PENDING)

  // Delivery
  deliveryAddress    String
  deliveryPostalCode String
  deliveryLat        Float?
  deliveryLng        Float?
  estimatedMinutes   Int?
  deliveredAt        DateTime?

  // Financials
  subtotal        Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  marginOffered   Decimal @db.Decimal(10, 2) // cashbackPercent × total = pool for distribution
  cashbackPercent Float   // snapshot of distributor's offer at order time

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  asaasChargeId String? // Asaas PIX charge reference
  invoiceUrl    String? // Asaas-hosted invoice page (real PDF/payment link) — surfaced as "Fatura"

  // FGOL used as partial payment
  fgolUsed         Decimal @default(0) @db.Decimal(20, 8)
  fgolUsedBrlValue Decimal @default(0) @db.Decimal(10, 2) // BRL equivalent at swap time

  // WhatsApp channel reference (conexbot conversation)
  waConversationId String?
  channel          String  @default("app") // "app" | "whatsapp"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       OrderItem[]
  commissions CommissionLedger[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
}

// ─── POS — physical establishment payments (QR code at counter) ───────────────

model PosPayment {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  // Nullable: the charge is created (AWAITING_SCAN) before a customer exists — it's
  // only known once someone scans the QR code, and a guest scan may never link a User at all.
  customerId      String?
  customer        User?         @relation(fields: [customerId], references: [id])

  totalAmount     Decimal @db.Decimal(10, 2) // full bill
  fgolUsed        Decimal @default(0) @db.Decimal(20, 8)
  fgolBrlValue    Decimal @default(0) @db.Decimal(10, 2) // BRL equiv of FGOL used
  pixAmount       Decimal @db.Decimal(10, 2) // remainder charged via PIX

  marginOffered   Decimal @db.Decimal(10, 2) // cashbackPercent × totalAmount
  cashbackPercent Float   // snapshot at payment time

  // QR code (generated by establishment panel, scanned by consumer app)
  qrToken     String   @unique // signed JWT with {estId, amount, exp}
  qrExpiresAt DateTime

  status        PosPaymentStatus @default(AWAITING_SCAN)
  asaasChargeId String? // PIX charge for pixAmount from consumer
  invoiceUrl    String? // Asaas-hosted invoice page (real PDF/payment link) — surfaced as "Fatura"
  asaasTransferId String? // internal Asaas transfer to establishment

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  commissions CommissionLedger[]
}

// ─── COMMISSION LEDGER ────────────────────────────────────────────────────────

model CommissionLedger {
  id          String @id @default(cuid())
  recipientId String
  recipient   User   @relation("Recipient", fields: [recipientId], references: [id])

  // Source transaction — one of these is set
  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id])
  posPaymentId String?
  posPayment   PosPayment? @relation(fields: [posPaymentId], references: [id])

  amount   Decimal          @db.Decimal(20, 8)
  currency Currency
  status   CommissionStatus @default(PENDING)

  // Role in the distribution
  role String
  // "consumer_cashback" | "network_l1" | "network_l2" | "network_l3"
  // | "network_l4" | "network_l5" | "credenciador" | "establishment_bonus" | "platform"

  matrixLevel Int? // which level of the 5×5 generated this

  // Blocking / expiry (mirrors affiliate state machine)
  blockedAt DateTime?
  expiresAt DateTime? // set on BLOCKED: now + 60 days
  expiredAt DateTime? // set when moved to EXPIRED → company revenue

  // FGOL batch settlement
  buybackBatchId String?

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── FGOL BUYBACK BATCHES (weekly — company buys FGOL from pool) ──────────────

model BuybackBatch {
  id             String @id @default(cuid())
  brlSpent       Decimal @db.Decimal(10, 2)
  fgolAcquired   Decimal @db.Decimal(20, 8)
  pricePerFgol   Decimal @db.Decimal(20, 8) // BRL/FGOL at swap moment
  polygonTxHash  String?

  commissionsSettled Int @default(0)

  executedAt DateTime
  createdAt  DateTime @default(now())
}

// ─── ON-CHAIN TRANSFERS (treasury <-> user wallet, processed async by a worker) ─
// Never inline with a PIX/purchase request: the DB ledger (User.fgolBalance) settles
// the payment instantly; these rows are queued and reconciled in the background.

model OnChainTransfer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  direction OnChainDirection
  amount    Decimal @db.Decimal(20, 8)

  // "commission_batch" (TO_USER, threshold flush) | "pix_withdrawal" | "marketplace_payment" (FROM_USER)
  reason      String
  referenceId String? // CommissionLedger.id, Order.id or PosPayment.id that triggered this

  txHash String?
  status OnChainTransferStatus @default(PENDING)
  error  String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([status])
  @@index([userId])
}

// ─── TREASURY REBALANCING ─────────────────────────────────────────────────────
// Sell-side (FGOL -> USDC when the Asaas BRL float runs low) is automated by the
// system. Buy-side (USDC -> FGOL, restocking the treasury from BRL commission
// revenue) is a manual admin action on an exchange — logged here for audit, not
// executed by this platform. USDC -> BRL off-ramp is also manual (admin marks
// brlConfirmed once the conversion lands and Asaas is topped up).

model TreasuryConversion {
  id String @id @default(cuid())

  direction  String // "SELL_FGOL_FOR_USDC" (automated) | "BUY_FGOL_WITH_USDC" (manual, admin-logged)
  fgolAmount Decimal @db.Decimal(20, 8)
  usdcAmount Decimal @db.Decimal(20, 8)
  txHash     String?

  triggeredBy String // "system_auto" or the admin User.id who logged a manual buy

  brlConfirmed Boolean   @default(false) // admin marks true after manually converting USDC->BRL and topping up Asaas
  brlAmount    Decimal?  @db.Decimal(10, 2)
  confirmedBy  String?
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
}

// ─── ASAAS SUB-ACCOUNTS registry ─────────────────────────────────────────────

model AsaasSubAccount {
  id        String @id @default(cuid())
  actorType String // "DISTRIBUTOR" | "CREDENCIADOR" | "ESTABLISHMENT"
  actorId   String // references the relevant table

  asaasAccountId String @unique
  pixKey         String?

  createdAt DateTime @default(now())
}

// ─── RATINGS ─────────────────────────────────────────────────────────────────

model Rating {
  id              String  @id @default(cuid())
  customerId      String
  distributorId   String?
  establishmentId String?
  score           Int     // 1–5
  comment         String?
  createdAt       DateTime @default(now())
}

// ─── SUBSCRIPTIONS (Free / Premium) ──────────────────────────────────────────

model Subscription {
  id         String   @id @default(cuid())
  userId     String   @unique
  plan       PlanType
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  asaasSubId String?  // Asaas recurring charge reference
  isActive   Boolean  @default(true)

  // Which configurable Plan (price/name/features) this subscription was created
  // against — nullable because rows created before Plan existed have none.
  planId String?
  planRef Plan? @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PLANS (SuperAdmin-configurable — price/name/features, not hardcoded) ─────

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // stable reference used by API/mobile, e.g. "premium"
  price        Decimal  @db.Decimal(10, 2)
  billingCycle String   @default("MONTHLY") // "MONTHLY" | "YEARLY"
  features     String[] // benefit bullet points shown in the upgrade UI
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

// ─── SYSTEM CONFIG (credentials managed via SuperAdmin — values encrypted) ────

model SystemConfig {
  key       String   @id  // e.g. "ASAAS_API_KEY"
  value     String       // AES-256-GCM encrypted
  label     String       // human-readable name shown in UI
  group     String       // "asaas" | "conexbot" | "polygon" | "web3auth" | "email" | "storage"
  sensitive Boolean @default(true) // if true, mask in GET responses
  updatedAt DateTime @updatedAt
  updatedBy String?      // User.id of the admin who last changed it
}

// ─── COMPANY REVENUE LEDGER (forfeited commissions + platform cut) ────────────

model CompanyRevenue {
  id     String @id @default(cuid())
  amount Decimal @db.Decimal(20, 8)
  currency Currency

  source String
  // "platform_cut" | "forfeited_commission" | "expired_premium"

  referenceId String? // CommissionLedger.id or Order.id

  createdAt DateTime @default(now())
}

// ─── WHATSAPP MESSAGE LOG ──────────────────────────────────────────────────────
// Every inbound/outbound message through the Conexbot integration, persisted —
// previously nothing was ever saved, so there was no conversation history
// anywhere. This is the data layer a real CRM view reads from.

enum WaDirection {
  INBOUND
  OUTBOUND
}

model WaMessage {
  id        String      @id @default(cuid())
  phone     String
  direction WaDirection
  text      String
  createdAt DateTime    @default(now())

  @@index([phone])
  @@index([createdAt])
}

// ─── PARTNER SIGNUP LEADS ──────────────────────────────────────────────────────
// Public "quero ser distribuidora" / "quero anunciar" forms on the site submit
// here instead of just redirecting to WhatsApp — gives SuperAdmin a real,
// reviewable queue instead of messages that only live in someone's phone.

enum PartnerLeadType {
  DISTRIBUTOR
  ESTABLISHMENT
}

enum PartnerLeadStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

model PartnerLead {
  id   String          @id @default(cuid())
  type PartnerLeadType

  name     String
  cnpj     String?
  phone    String
  email    String?
  city     String?
  state    String?
  category String? // establishment segment (restaurante, farmacia, etc.) — DISTRIBUTOR leads leave this null
  message  String?

  status PartnerLeadStatus @default(PENDING)
  notes  String? // internal admin notes while working the lead

  // Set only for leads created via the Web3Auth self-service signup — links to
  // the User (PENDING_APPROVAL, wallet-authenticated) created at signup time.
  // Approving this lead is what creates the real Distributor/Establishment
  // record (needs credenciadorId/cashbackPercent/address that only SuperAdmin
  // assigns) and flips the linked user to ACTIVE. Null for old-style leads
  // (no account exists yet — approving those is just a status label today).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
