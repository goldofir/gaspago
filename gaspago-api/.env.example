# ── OBRIGATÓRIO em .env — tudo mais é configurado no SuperAdmin ───────────────

# Banco de dados
DATABASE_URL="postgresql://gaspago:gaspago@localhost:5432/gaspago"

# Redis
REDIS_URL="redis://localhost:6379"

# Chave mestra de criptografia — 64 hex chars (32 bytes)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=""

# Porta da API
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Superadmin de bootstrap — criado/validado no primeiro start da API
ADMIN_EMAIL="admin@gaspago.com.br"
# Hash bcrypt da senha (preferido — gere com: node scripts/hash-password.js "sua-senha-aqui")
ADMIN_PASSWORD_HASH=""
# (legado, texto puro — evite em produção, só existe como fallback se ADMIN_PASSWORD_HASH não estiver definido)
# ADMIN_PASSWORD=""

# ── OPCIONAL — sobrescreve o banco para desenvolvimento rápido ────────────────
# Estas variáveis são lidas como fallback se a chave não estiver no banco.
# Em produção, configure tudo pelo SuperAdmin → Credenciais.

# ASAAS_API_KEY=
# ASAAS_ENV=sandbox
# CONEXBOT_API_URL=
# CONEXBOT_API_KEY=
# CONEXBOT_WEBHOOK_SECRET=
# POLYGON_RPC_URL=https://polygon-rpc.com
# FGOL_CONTRACT=0xa1B7797F97eE6C928A6Ce0E403f345b68945C6D7
# PLATFORM_WALLET_KEY=
# WEB3AUTH_CLIENT_ID=
# WEB3AUTH_CLIENT_SECRET=
# WEB3AUTH_NETWORK=sapphire_devnet
# JWT_SECRET=
# QR_JWT_SECRET=
# GOOGLE_CLIENT_ID=          # OAuth 2.0 Web client ID (Google Cloud Console)
# GOOGLE_CLIENT_SECRET=      # OAuth 2.0 Web client secret
