# Copie para .env e ajuste o IP para o da sua maquina na rede local
# (o celular/emulador precisa alcancar esse endereco — localhost nao funciona no dispositivo fisico)
EXPO_PUBLIC_API_URL=http://192.168.0.100:3030

# Site institucional (paginas de Termos e Privacidade abertas pelo app)
# Em producao, aponte para o dominio real (ex.: https://gaspago.app)
EXPO_PUBLIC_WEB_URL=http://192.168.0.100:3031

# Mesmo Client ID configurado em SuperAdmin -> Credenciais -> Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
